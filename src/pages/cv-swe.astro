---
import Layout from "../layouts/Layout.astro";
import profileOgImage from "../assets/profile-og.png";

const site = import.meta.env.SITE;
const title = "Anastasia Tulentseva - Senior Software Engineer CV";
const description =
  "CV / Résumé - Anastasia Tulentseva, Senior Software Engineer & Tech Lead";
const websiteUrl = new URL("/", site).href;
const sweCvPdf = "/cv-swe.pdf";
const ogImage = `${new URL(profileOgImage.src, site).href}?v=2`;
const ogImageWidth = String(profileOgImage.width);
const ogImageHeight = String(profileOgImage.height);
---

<Layout
  title={title}
  description={description}
  noindex
  navLinks={[
    {
      href: sweCvPdf,
      label: "Download PDF",
      ariaLabel: "Download PDF of the Software Engineer CV",
      download: "Anastasia Tulentseva - SWE - CV.pdf",
    },
    {
      href: "/cv/",
      label: "Leadership CV",
      ariaLabel: "View leadership CV",
    },
  ]}
>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content="Professional headshot of Anastasia Tulentseva" />
    <meta property="og:url" content={new URL(Astro.url.pathname, site).href} />
    <meta property="og:site_name" content="Anastasia Tulentseva" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Professional headshot of Anastasia Tulentseva" />
  </Fragment>
  <main class="w-full min-w-0 overflow-x-hidden">
    <style is:global>
      .cv-header {
        background-color: var(--color-charcoal, #1f2937);
      }
      @media print {
        @page {
          margin: 0;
          size: A4;
        }
        body {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
          background-color: white !important;
          margin: 0;
          padding: 0;
        }
        .print-content {
          padding-left: 0.8cm !important;
          padding-right: 0.8cm !important;
        }
        .print-edu-skills-grid {
          display: grid !important;
          grid-template-columns: 1fr 2fr !important;
          gap: 1rem !important;
        }
        .print-education-col {
          grid-column: 1 !important;
        }
        .print-skills-col {
          grid-column: 2 !important;
        }
        .break-before-page {
          page-break-before: always;
          padding-top: 2rem;
          margin-top: 2rem;
          display: block;
        }
        .no-print {
          display: none !important;
        }
        .cv-header {
          background-color: var(--color-charcoal, #1f2937) !important;
        }
      }
    </style>

    <div
      class="py-8 px-4 sm:px-8 print:py-0 print:px-0 min-h-screen print:min-h-0"
    >
      <div
        class="max-w-4xl mx-auto bg-white shadow-xl print:shadow-none print:w-full print:max-w-none rounded-none sm:rounded-lg print:rounded-none overflow-hidden text-charcoal font-sans leading-relaxed relative"
      >
        <header
          class="cv-header text-white p-8 sm:p-10 print:text-white print:p-6 print:pb-4 relative"
        >
          <div
            class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 print:flex-row print:justify-between print:items-center print:gap-2"
          >
            <div>
              <h1
                class="font-serif text-3xl sm:text-4xl font-bold tracking-tight mb-2 print:text-3xl print:mb-0"
              >
                Anastasia Tulentseva
              </h1>
              <h2
                class="text-xl text-gray-400 font-medium print:text-lg"
              >
                Senior Software Engineer & Tech Lead
              </h2>
            </div>
            <div
              class="text-sm space-y-2 text-gray-400 min-w-fit print:text-xs print:space-y-1 print:text-right"
            >
              <div class="flex items-center gap-2 print:justify-end">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="print:w-3 print:h-3"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Dublin, Ireland</span>
              </div>
              <div class="flex items-center gap-2 print:justify-end">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="print:w-3 print:h-3"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <a
                  href="mailto:anastasia@tulentsev.com"
                  class="hover:text-white transition-colors"
                  >anastasia@tulentsev.com</a
                >
              </div>
              <div class="flex items-center gap-2 print:justify-end">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="print:w-3 print:h-3"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
                <a href="tel:+353894853415" class="hover:text-white transition-colors"
                  >+353 89 485 3415</a
                >
              </div>
              <div
                class="flex gap-4 pt-1 print:pt-0 print:justify-end print:gap-2"
              >
                <a
                  href={websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 hover:text-white transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="print:w-3 print:h-3"
                  >
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path
                      d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                    ></path>
                  </svg>
                  <span
                    class="underline decoration-gray-500 hover:decoration-white"
                    >Website</span
                  >
                </a>
                <a
                  href="https://www.linkedin.com/in/atulentseva/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 hover:text-white transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="print:w-3 print:h-3"
                  >
                    <path
                      d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                    ></path>
                    <rect x="2" y="9" width="4" height="12"></rect>
                    <circle cx="4" cy="4" r="2"></circle>
                  </svg>
                  <span
                    class="underline decoration-gray-500 hover:decoration-white"
                    >LinkedIn</span
                  >
                </a>
                <a
                  href="https://github.com/anastasiiatulentseva"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-1 hover:text-white transition-colors"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="print:w-3 print:h-3"
                  >
                    <path
                      d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
                    ></path>
                  </svg>
                  <span
                    class="underline decoration-gray-500 hover:decoration-white"
                    >GitHub</span
                  >
                </a>
              </div>
            </div>
          </div>
        </header>

        <div
          class="print-content p-8 sm:p-10 space-y-8 print:p-6 print:space-y-5"
        >
          <section>
            <h3
              class="font-serif text-lg font-bold uppercase tracking-wider text-charcoal border-b-2 border-gray-200 pb-2 mb-4 print:mb-2 print:text-base print:pb-1"
            >
              Profile
            </h3>
            <div class="space-y-2 text-sm print:leading-tight">
              <p class="text-gray-700 text-left">
                Senior Software Engineer and Tech Lead with over 13 years of
                experience architecting scalable web platforms and complex API
                integrations. I apply a pragmatic approach to system design,
                focusing on maintainable, right-sized solutions. I am a strong
                technical communicator who excels at aligning business
                requirements with technical execution.
              </p>
              <p class="text-gray-700 text-left">
                I am now seeking an opportunity to build impactful products,
                ideally leveraging my deep roots in Ruby on Rails alongside
                modern frontend architectures.
              </p>
            </div>
            <div class="text-xs text-gray-500 mt-2">
              Core Competencies: Full-Stack Engineering, API Design &amp;
              Integration, System Architecture, Product-Minded Engineering,
              Technical Leadership.
            </div>
          </section>

          <section>
            <h3
              class="font-serif text-lg font-bold uppercase tracking-wider text-charcoal border-b-2 border-gray-200 pb-2 mb-6 print:mb-2 print:text-base print:pb-1"
            >
              Experience
            </h3>

            <div class="mb-10 break-inside-avoid print:mb-4">
              <div class="flex justify-between items-baseline mb-1">
                <h4
                  class="font-serif text-xl font-bold text-charcoal print:text-lg"
                >
                  Founding Engineer &amp; Tech Lead
                </h4>
                <span
                  class="text-sm font-medium text-gray-500 whitespace-nowrap"
                  >Apr 2025 – Present</span
                >
              </div>
              <div
                class="text-gray-700 font-semibold mb-1 flex items-center gap-1 text-sm"
              >
                Anato <span class="text-gray-400">|</span> Dublin, Ireland
              </div>
              <div class="text-xs text-gray-500 mb-3">
                Food startup building crumb structure analysis software. Tech
                stack: Next.js, React, TypeScript, Tailwind CSS, Swift/SwiftUI.
              </div>
              <div class="space-y-3 print:space-y-2">
                <div>
                  <h5
                    class="text-sm font-bold text-charcoal uppercase mb-1 tracking-wide"
                  >
                    System Architecture &amp; Engineering
                  </h5>
                  <ul
                    class="list-disc pl-5 space-y-0.5 text-sm text-gray-700 print:leading-snug"
                  >
                    <li>
                      <span class="font-semibold">Web Platform Development:</span
                      > Architected and built the central back-office portal from
                      scratch using Next.js, React, and TypeScript, providing a unified
                      interface for data analytics and client operations.
                    </li>
                    <li>
                      <span class="font-semibold">API Integration:</span> Designed
                      Next.js API routes to integrate exclusively with the central
                      backend API, securely powering the data analytics and operations
                      dashboard.
                    </li>
                    <li>
                      <span class="font-semibold">Cross-Platform Alignment:</span
                      > Enforced product consistency across the ecosystem, ensuring
                      feature parity, shared UI/UX design patterns, and unified terminology
                      between the web portal and the iOS mobile app.
                    </li>
                    <li>
                      <span class="font-semibold">Testing &amp; Reliability:</span
                      > Established comprehensive, automated testing pipelines across
                      the web platform utilising Vitest and Playwright to ensure high
                      confidence during rapid iteration cycles.
                    </li>
                  </ul>
                </div>
                <div>
                  <h5
                    class="text-sm font-bold text-charcoal uppercase mb-1 tracking-wide"
                  >
                    Infrastructure &amp; Mobile Delivery
                  </h5>
                  <ul
                    class="list-disc pl-5 space-y-0.5 text-sm text-gray-700 print:leading-snug"
                  >
                    <li>
                      <span class="font-semibold">Cross-Platform Mobile Scope:</span
                      > Expanded technical ownership to lead the architecture and
                      App Store deployment of the iOS app (SwiftUI, ARKit/RealityKit,
                      LiDAR). Utilised AI-assisted workflows for rapid prototyping
                      while delegating complex native features to specialised iOS
                      developers.
                    </li>
                    <li>
                      <span class="font-semibold">Cloud &amp; Telemetry:</span> Managed
                      AWS cloud infrastructure, securing $10k in startup credits to
                      minimize operational costs. Utilised Firebase Crashlytics for
                      mobile telemetry tracking and production debugging.
                    </li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="mb-8 break-inside-avoid print:mb-4">
              <div class="flex justify-between items-baseline mb-1">
                <h4
                  class="font-serif text-lg font-bold text-charcoal print:text-base"
                >
                  Senior Product Engineer
                </h4>
                <span
                  class="text-sm font-medium text-gray-500 whitespace-nowrap"
                  >Jul 2023 – Dec 2024</span
                >
              </div>
              <div
                class="text-gray-700 font-semibold mb-1 flex items-center gap-1 text-sm"
              >
                Kubicle <span class="text-gray-400">|</span> Dublin, Ireland
              </div>
              <div class="text-xs text-gray-500 mb-1">
                B2B e-learning platform. <span class="font-medium"
                  >Tech stack:</span
                > Ruby on Rails, React.js, PostgreSQL, MUI.
              </div>
              <ul
                class="list-disc pl-5 space-y-0.5 text-sm text-gray-700 print:leading-snug"
              >
                <li>
                  <span class="font-semibold">Performance Optimisation:</span> Engineered
                  data-intensive reporting pages and dashboards. Optimised Rails API
                  retrieval times by deeply restructuring database queries and eliminating
                  N+1 bottlenecks.
                </li>
                <li>
                  <span class="font-semibold">Frontend Architecture &amp; Dashboards:</span
                  > Refactored legacy Active Admin pages and developed brand-new React/MUI
                  dashboards for customer administrators to improve data management
                  workflows.
                </li>
                <li>
                  <span class="font-semibold">Revenue-Critical Features:</span> Implemented
                  a new licensing tier and administrative dashboard, safely modifying
                  core billing logic to ensure high reliability for money-related platform
                  code.
                </li>
                <li>
                  <span class="font-semibold">System Reliability:</span> Participated
                  in on-call rotation schedules, rapidly debugging and deploying fixes
                  for production issues to maintain high system availability.
                </li>
              </ul>
            </div>

            <div class="mb-8 break-inside-avoid print:mb-4 break-before-page">
              <div class="flex justify-between items-baseline mb-1">
                <h4
                  class="font-serif text-lg font-bold text-charcoal print:text-base"
                >
                  Senior Software Engineer
                </h4>
                <span
                  class="text-sm font-medium text-gray-500 whitespace-nowrap"
                  >Nov 2019 – Dec 2022</span
                >
              </div>
              <div
                class="text-gray-700 font-semibold mb-1 flex items-center gap-1 text-sm"
              >
                Bonkers.ie <span class="text-gray-400">|</span> Dublin, Ireland
              </div>
              <div class="text-xs text-gray-500 mb-1">
                Price comparison website. <span class="font-medium"
                  >Tech stack:</span
                > Ruby on Rails, Vue.js, MySQL, OpenSearch, AWS.
              </div>
              <ul
                class="list-disc pl-5 space-y-0.5 text-sm text-gray-700 print:leading-snug"
              >
                <li>
                  <span class="font-semibold">Enterprise Integrations:</span> Led backend
                  development for the company's inaugural API integration with Zurich
                  Insurance. Architected data flows and liaised with partner engineers
                  to launch two product lines on schedule with zero significant production
                  bugs.
                </li>
                <li>
                  <span class="font-semibold">Project Leadership:</span> Managed the
                  backend workload and coordinated with internal Frontend teams and external
                  QA to ensure strict adherence to partner requirements and rigorous
                  deployment cycles.
                </li>
                <li>
                  <span class="font-semibold">Complex Business Logic:</span> Safely
                  navigated and extended the highly complex electricity pricing engine
                  to incorporate new smart meter tariffs, ensuring strict mathematical
                  accuracy for supplier comparisons without breaking legacy calculations.
                </li>
                <li>
                  <span class="font-semibold">Feature Engineering:</span> Designed and
                  implemented a click-tracking and virtual budgeting system to accurately
                  manage, decrement, and represent paid partner placement balances.
                </li>
              </ul>
            </div>

            <div class="mb-8 break-inside-avoid print:mb-4">
              <div class="flex justify-between items-baseline mb-1">
                <h4
                  class="font-serif text-lg font-bold text-charcoal print:text-base"
                >
                  Software Engineer &amp; Team Lead
                </h4>
                <span
                  class="text-sm font-medium text-gray-500 whitespace-nowrap"
                  >May 2017 – Sep 2019</span
                >
              </div>
              <div
                class="text-gray-700 font-semibold mb-1 flex items-center gap-1 text-sm"
              >
                InStat Sport <span class="text-gray-400">|</span> Remote
              </div>
              <div class="text-xs text-gray-500 mb-1">
                Sports performance analysis company. <span class="font-medium"
                  >Tech stack:</span
                > Ruby on Rails, React.js, Node.js, Elasticsearch, PostgreSQL.
              </div>
              <ul
                class="list-disc pl-5 space-y-0.5 text-sm text-gray-700 print:leading-snug"
              >
                <li>
                  <span class="font-semibold">Greenfield Development:</span> Fast-tracked
                  from Junior Backend Developer to Lead for a new project. Built end-to-end
                  features spanning React.js frontend, Node.js services, and Rails APIs.
                </li>
                <li>
                  <span class="font-semibold">Technical Standards:</span> Established
                  core coding practices and architectural guidelines for the newly formed
                  Node/React team, ensuring maintainability and scalability.
                </li>
                <li>
                  <span class="font-semibold">Media Processing Pipelines:</span> Maintained
                  and deployed high-load video manipulation services across a 50-server
                  cluster. Enhanced an existing Ruby and FFmpeg service to dynamically
                  burn user-drawn graphical overlays into downloadable video layers.
                </li>
                <li>
                  <span class="font-semibold">Backend Optimisation:</span> Optimised
                  the core API to handle advanced, high-throughput client requests. Collaborated
                  closely with Database and DevOps teams to fine-tune query performance
                  and ensure system reliability under heavy loads.
                </li>
                <li>
                  <span class="font-semibold">Team Building:</span> Actively participated
                  in technical interviews, evaluating candidates for culture fit and technical
                  proficiency to build a strong engineering unit.
                </li>
              </ul>
            </div>
          </section>

          <div
            class="print-edu-skills-grid grid grid-cols-1 md:grid-cols-3 gap-8 break-inside-avoid print:gap-4 print:mt-2"
          >
            <div class="print-education-col md:col-span-1 space-y-8 print:space-y-6">
              <section>
                <h3
                  class="font-serif text-lg font-bold uppercase tracking-wider text-charcoal border-b-2 border-gray-200 pb-2 mb-4 print:mb-2 print:text-base print:pb-1"
                >
                  Education
                </h3>
                <div>
                  <h4 class="font-bold text-charcoal text-sm">Master's Degree</h4>
                  <div class="text-sm text-gray-700 font-medium">
                    Computer Science
                  </div>
                  <div class="text-xs text-gray-500 mt-1">
                    Berdyansk University of Management and Business, Ukraine
                  </div>
                </div>
              </section>
              <section>
                <h3
                  class="font-serif text-lg font-bold uppercase tracking-wider text-charcoal border-b-2 border-gray-200 pb-2 mb-4 print:mb-2 print:text-base print:pb-1"
                >
                  Citizenship
                </h3>
                <div>
                  <div class="text-sm text-gray-700 font-medium">
                    Irish Citizen
                  </div>
                  <div class="text-xs text-gray-500 mt-1">
                    EU Passport &amp; UK Right to Work
                  </div>
                </div>
              </section>
            </div>

            <section class="print-skills-col md:col-span-2">
              <h3
                class="font-serif text-lg font-bold uppercase tracking-wider text-charcoal border-b-2 border-gray-200 pb-2 mb-4 print:mb-2 print:text-base print:pb-1"
              >
                Skills
              </h3>
              <div class="space-y-3 print:space-y-2">
                <div>
                  <h4
                    class="text-sm font-bold text-charcoal mb-0.5"
                  >
                    Software Engineering
                  </h4>
                  <p class="text-xs text-gray-700 leading-snug">
                    <span class="font-semibold text-gray-600">Core:</span> Ruby on
                    Rails, Next.js, React.js, Node.js, Vue.js, TypeScript, JavaScript,
                    Tailwind CSS.<br />
                    <span class="font-semibold text-gray-600">Architecture:</span> RESTful
                    APIs, System Design, Microservices, Performance Tuning, Performance
                    Profiling, Data Modelling.
                  </p>
                </div>
                <div>
                  <h4
                    class="text-sm font-bold text-charcoal mb-0.5"
                  >
                    Infrastructure &amp; Tools
                  </h4>
                  <p class="text-xs text-gray-700 leading-snug">
                    <span class="font-semibold text-gray-600">Databases:</span> PostgreSQL,
                    MySQL, SQL, Elasticsearch, OpenSearch.<br />
                    <span class="font-semibold text-gray-600">Cloud &amp; Testing:</span
                    > AWS, Azure, Docker, FFmpeg, Firebase, Playwright, Vitest, CI/CD
                    Strategy.
                  </p>
                </div>
                <div>
                  <h4
                    class="text-sm font-bold text-charcoal mb-0.5"
                  >
                    Leadership &amp; Delivery
                  </h4>
                  <p class="text-xs text-gray-700 leading-snug">
                    Technical Leadership &amp; Mentorship, Cross-Functional
                    Collaboration, Enterprise Integrations, SDLC Optimisation,
                    AI-Assisted Engineering, Rapid Prototyping, Technical Hiring.
                  </p>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
